{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public chat directory profile and real-time online presence for a signed-in user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Public display name shown in chat lists and call overlays."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Profile avatar URL or empty string."
        },
        "bio": {
          "type": "string",
          "maxLength": 160,
          "description": "Short status line or bio."
        },
        "isOnline": {
          "type": "boolean",
          "description": "Whether the user is currently active in the app."
        },
        "isDiscoverable": {
          "type": "boolean",
          "description": "Whether the user appears in the contacts directory."
        },
        "lastSeen": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last heartbeat or disconnect."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was first created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of most recent profile update."
        }
      },
      "required": [
        "uid",
        "displayName",
        "photoURL",
        "bio",
        "isOnline",
        "isDiscoverable",
        "lastSeen",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII document storing user email, accessible strictly by the owner.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "ChatRoom": {
      "title": "ChatRoom",
      "description": "One-to-one direct conversation room between two authenticated users.",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participants": {
          "type": "array",
          "description": "Bounded 2-element sorted array of participant UIDs."
        },
        "participantA": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participantB": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participantAName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "participantBName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "participantAPhoto": {
          "type": "string",
          "maxLength": 500
        },
        "participantBPhoto": {
          "type": "string",
          "maxLength": 500
        },
        "lastMessageText": {
          "type": "string",
          "maxLength": 500
        },
        "lastMessageSenderId": {
          "type": "string",
          "maxLength": 128
        },
        "lastMessageAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "chatId",
        "participants",
        "participantA",
        "participantB",
        "participantAName",
        "participantBName",
        "participantAPhoto",
        "participantBPhoto",
        "lastMessageText",
        "lastMessageSenderId",
        "lastMessageAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A real-time message or call summary event inside a ChatRoom.",
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chatId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participants": {
          "type": "array",
          "description": "Bounded 2-element array matching parent ChatRoom participants."
        },
        "senderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "type": {
          "type": "string",
          "enum": ["text", "call_event"]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "readBy": {
          "type": "array",
          "description": "Bounded array (max 2) of UIDs who have read this message."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "messageId",
        "chatId",
        "participants",
        "senderId",
        "senderName",
        "type",
        "text",
        "readBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "TypingState": {
      "title": "TypingState",
      "description": "Per-participant real-time typing indicator within a ChatRoom.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chatId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participants": {
          "type": "array",
          "description": "Bounded 2-element array matching parent ChatRoom participants."
        },
        "isTyping": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "chatId", "participants", "isTyping", "updatedAt"]
    },
    "CallSession": {
      "title": "CallSession",
      "description": "WebRTC audio or video call signaling session between two participants.",
      "type": "object",
      "properties": {
        "callId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chatId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "callerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "calleeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "callerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "callerPhoto": {
          "type": "string",
          "maxLength": 500
        },
        "calleeName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "calleePhoto": {
          "type": "string",
          "maxLength": 500
        },
        "callType": {
          "type": "string",
          "enum": ["audio", "video"]
        },
        "status": {
          "type": "string",
          "enum": ["ringing", "active", "ended", "declined", "missed"]
        },
        "offerType": {
          "type": "string",
          "enum": ["offer"]
        },
        "offerSdp": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "answerType": {
          "type": "string",
          "enum": ["", "answer"]
        },
        "answerSdp": {
          "type": "string",
          "maxLength": 20000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "callId",
        "chatId",
        "callerId",
        "calleeId",
        "callerName",
        "callerPhoto",
        "calleeName",
        "calleePhoto",
        "callType",
        "status",
        "offerType",
        "offerSdp",
        "answerType",
        "answerSdp",
        "createdAt",
        "updatedAt"
      ]
    },
    "IceCandidate": {
      "title": "IceCandidate",
      "description": "Trickle ICE candidate exchanged during WebRTC call negotiation.",
      "type": "object",
      "properties": {
        "candidateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "callId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participants": {
          "type": "array",
          "description": "Bounded 2-element array [callerId, calleeId] matching parent CallSession."
        },
        "senderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "candidate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "sdpMid": {
          "type": "string",
          "maxLength": 64
        },
        "sdpMLineIndex": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "candidateId",
        "callId",
        "participants",
        "senderId",
        "candidate",
        "sdpMid",
        "sdpMLineIndex",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public chat directory profiles and online presence status."
    },
    "/users/{userId}/private/info": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Owner-only PII document holding user email."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatRoom" },
      "description": "Deterministic 1-to-1 chat room metadata and last message summary."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages belonging to a specific 1-to-1 chat room."
    },
    "/chats/{chatId}/typing/{userId}": {
      "schema": { "$ref": "#/entities/TypingState" },
      "description": "Per-user typing state inside a specific chat room."
    },
    "/calls/{callId}": {
      "schema": { "$ref": "#/entities/CallSession" },
      "description": "WebRTC audio/video call signaling sessions."
    },
    "/calls/{callId}/candidates/{candidateId}": {
      "schema": { "$ref": "#/entities/IceCandidate" },
      "description": "WebRTC ICE candidates for a specific call session."
    }
  }
}
